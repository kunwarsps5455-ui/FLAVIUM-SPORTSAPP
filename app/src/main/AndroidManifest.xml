<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Syllabus Topic: Internet Permission in AndroidManifest.xml for WebView -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlaviumSportsApp">

        <!-- Main Launcher -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activities -->
        <activity
            android:name=".ui.SportsActivity"
            android:label="Sports Catalog"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.TeamsActivity"
            android:label="Teams &amp; Candidates"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AddEditTeamActivity"
            android:label="Team Registration"
            android:parentActivityName=".ui.TeamsActivity" />

        <activity
            android:name=".ui.TeamDetailActivity"
            android:label="Team Roster"
            android:parentActivityName=".ui.TeamsActivity" />

        <activity
            android:name=".ui.AddEditCandidateActivity"
            android:label="Candidate Registration"
            android:parentActivityName=".ui.TeamDetailActivity" />

        <activity
            android:name=".ui.FixtureWizardActivity"
            android:label="Arrange Fixtures"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.FixturesActivity"
            android:label="Fixtures &amp; Scores"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.MatchDetailActivity"
            android:label="Match Score"
            android:parentActivityName=".ui.FixturesActivity" />

        <activity
            android:name=".ui.StandingsActivity"
            android:label="Standings &amp; Points"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Syllabus Topic: WebView Activity -->
        <activity
            android:name=".ui.RulesWebViewActivity"
            android:label="Sports Fest Rules"
            android:parentActivityName=".ui.MainActivity" />

    </application>

</manifest>
