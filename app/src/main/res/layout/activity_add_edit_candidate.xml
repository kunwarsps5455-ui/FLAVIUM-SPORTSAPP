<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootCandidateLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/flavium_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTeamHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Team: Titan Strikers"
            android:textColor="@color/flavium_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Add player / athlete to the team roster"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Candidate Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Candidate / Player Name *"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCandidateName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/edit_text"
            android:hint="Full Name"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp" />

        <!-- Jersey / Chest Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Jersey / Chest Number"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etJerseyNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/edit_text"
            android:hint="e.g. 07, 10, 99"
            android:inputType="text"
            android:paddingHorizontal="12dp" />

        <!-- Role / Position -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Position / Role"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRole"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/edit_text"
            android:hint="e.g. Captain, Batsman, Bowler, Striker, Sprinter"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp" />

        <!-- Contact Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Contact Number (Optional)"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etContact"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/edit_text"
            android:hint="Mobile / WhatsApp number"
            android:inputType="phone"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/btnSaveCandidate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="Save Candidate"
            android:textSize="15sp"
            android:backgroundTint="@color/flavium_primary" />

    </LinearLayout>
</ScrollView>
