<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootWizardLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/flavium_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arrange Fixtures &amp; Pools"
            android:textColor="@color/flavium_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configure pool divisions, league rounds, match overs, and tournament brackets."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Step 1: Select Sport -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. Select Sport Discipline *"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/btn_dropdown" />

        <!-- Step 2: Division Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Select Division (Strict Isolation) *"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBoys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Boys Division"
                android:textColor="@color/boys_blue"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbGirls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Girls Division"
                android:textColor="@color/girls_pink"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Availability Status -->
        <TextView
            android:id="@+id/tvAvailableTeamsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#E8F5E9"
            android:padding="10dp"
            android:text="Teams info loading..."
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGenderWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔒 Strict Gender Isolation Active: Only Boys teams will be pooled together."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Step 3: Match Format / Overs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Match Rules &amp; Overs Format *"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMatchFormat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/edit_text"
            android:hint="e.g. 8 Overs Match or 20 Min Halves"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:text="8 Overs Match" />

        <!-- Step 4: Tournament Format -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="4. Tournament Structure *"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTournamentType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbLeaguePools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Pools &amp; League Stage (Groups + Round Robin)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbKnockout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Direct Knockout Tournament (Single Elimination)"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Pool / League Options Container -->
        <LinearLayout
            android:id="@+id/layoutPoolOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EDE7F6"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pool Configuration:"
                android:textColor="#4527A0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="How many pools to create? (e.g. 2 for Pool A &amp; Pool B)"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNumPools"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/edit_text"
                android:hint="2"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:text="2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="How many league stage matches per team?"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgRoundRobinChoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFullRoundRobin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Full Round Robin (Every team plays all pool rivals)"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbCustomLeagueMatches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Custom Match Limit (specify number of rounds)"
                    android:textSize="12sp" />
            </RadioGroup>

            <EditText
                android:id="@+id/etLeagueMatches"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/edit_text"
                android:hint="e.g. 3 matches per team"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:text="3"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Generate &amp; Arrange Fixtures"
            android:textSize="15sp"
            android:backgroundTint="@color/flavium_primary" />

    </LinearLayout>
</ScrollView>
