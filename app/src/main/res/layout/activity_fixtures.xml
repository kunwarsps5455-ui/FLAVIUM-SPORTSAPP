<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFixturesLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Filters Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Sport:"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerSports"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioGroup
            android:id="@+id/rgGenderFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All" />

            <RadioButton
                android:id="@+id/rbBoys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Boys"
                android:textColor="@color/boys_blue" />

            <RadioButton
                android:id="@+id/rbGirls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Girls"
                android:textColor="@color/girls_pink" />
        </RadioGroup>

        <Button
            android:id="@+id/btnOpenStandings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points Table"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFixtureCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingVertical="4dp"
        android:text="Showing Fixtures"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Syllabus Topic: ListView -->
    <ListView
        android:id="@+id/lvFixtures"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/tvEmptyFixtures"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:text="No fixtures found for selected sport and gender.\nOpen 'Arrange Fixtures' to generate matches."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
